                                                {["Authentic Product", "Verified Seller", "Dermatologist Inspired", "Imported Product", "Own Brand"].map((item) => <button key={item} type="button" onClick={() => setProductBadge(item)} className={`rounded-full px-3 py-2 text-xs font-bold transition ${productBadge === item ? "bg-[#5E7F85] text-white" : "bg-stone-50 text-slate-600 hover:bg-stone-100"}`}>{item}</button>)}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div className="rounded-[1.7rem] border border-slate-200 bg-white p-5 shadow-sm">
                                    <div className="flex items-center justify-between gap-3"><div className="text-sm font-bold text-slate-900">Upload Readiness</div><b className="text-sm text-[#5E7F85]">{contentScore}%</b></div>
                                    <div className="mt-3 h-3 overflow-hidden rounded-full bg-stone-100"><div className="h-full rounded-full bg-[#5E7F85]" style={{ width: `${contentScore}%` }} /></div>
                                    <div className="mt-4 grid gap-2 text-xs font-semibold text-slate-600">
                                        <div className="rounded-xl bg-stone-50 px-3 py-2">{mainImageReady ? "✅" : "○"} Main image</div>
                                        <div className="rounded-xl bg-stone-50 px-3 py-2">{galleryImages.length >= 3 ? "✅" : "○"} Gallery minimum 3</div>
                                        <div className="rounded-xl bg-stone-50 px-3 py-2">{shortDescription ? "✅" : "○"} Short description</div>
                                        <div className="rounded-xl bg-stone-50 px-3 py-2">{seoTitle ? "✅" : "○"} SEO title</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div className="mt-5 space-y-4">
                            {[["Short Description", shortDescription, setShortDescription], ["Full Description", fullDescription, setFullDescription], ["Product Details", productDetails, setProductDetails], ["How to Use", howToUse, setHowToUse], ["Ingredients", ingredients, setIngredients]].map(([label, value, setter]) => <label key={label} className="block space-y-2"><div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"><div className="flex items-center gap-2"><div className="text-sm font-medium text-slate-600">{label}</div><span className={`rounded-full px-2 py-1 text-[10px] font-bold ${value ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700"}`}>{value ? "DONE" : "MISSING"}</span></div><div className="flex flex-wrap gap-1"><button type="button" onClick={() => runContentHelper(label, setter, "generate")} className="rounded-full bg-[#5E7F85]/10 px-3 py-1.5 text-[10px] font-bold text-[#5E7F85]">Generate</button><button type="button" onClick={() => runContentHelper(label, setter, "short")} className="rounded-full bg-stone-100 px-3 py-1.5 text-[10px] font-bold text-slate-600">Make Short</button><button type="button" onClick={() => showActionToast(`${label} Bangla helper ready`)} className="rounded-full bg-stone-100 px-3 py-1.5 text-[10px] font-bold text-slate-600">Bangla</button></div></div><textarea value={value} onChange={(event) => { setter(event.target.value); setSaveStatus("Unsaved changes"); }} className="h-28 w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm outline-none" placeholder={label} /></label>)}
                        </div>
                    </div>

                    <div className="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
                        <div className="flex items-center justify-between gap-3"><div><h2 className="text-xl font-bold tracking-tight">PDP Content & Conversion</h2></div><Badge tone="brand">Sales Engine</Badge></div>
                        <div className="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                            {[["routine", "Show Routine Builder"], ["fbt", "Show Frequently Bought Together"], ["results", "Show Visible Results"]].map(([key, label]) => <button key={key} type="button" onClick={() => setPdpBlocks((current) => ({ ...current, [key]: !current[key] }))} className="flex items-center justify-between rounded-2xl bg-stone-50 p-4 text-left transition hover:bg-stone-100"><span className="text-sm font-medium text-slate-700">{label}</span><span className={`rounded-full px-3 py-1 text-xs font-bold ${pdpBlocks[key] ? "bg-emerald-50 text-emerald-700" : "bg-slate-200 text-slate-500"}`}>{pdpBlocks[key] ? "ON" : "OFF"}</span></button>)}
                        </div>
                        <div className="mt-5 grid gap-4 md:grid-cols-2"><label className="block space-y-2"><div className="text-sm font-medium text-slate-600">Why It Works</div><textarea className="h-28 w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm outline-none" placeholder="Helps reduce excess oil and acne prone skin" /></label><label className="block space-y-2"><div className="text-sm font-medium text-slate-600">Best For</div><textarea className="h-28 w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm outline-none" placeholder={`Acne
Daily Skincare
Simple Routine Support`} /></label></div>

                        <div className="mt-5 rounded-[1.5rem] border border-slate-200 bg-stone-50 p-5">
                            <div className="text-sm font-bold text-slate-900">Routine Placement</div>
                            <div className="mt-4 grid gap-4 md:grid-cols-3">
                                <label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Routine Step</div><select value={routineStep} onChange={(event) => setRoutineStep(event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none"><option>Cleanser</option><option>Toner</option><option>Serum</option><option>Treatment</option><option>Moisturizer</option><option>Sunscreen</option><option>Hair Care</option><option>Body Care</option></select></label>
                                <label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Use Time</div><select value={routineTime} onChange={(event) => setRoutineTime(event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none"><option>AM</option><option>PM</option><option>AM + PM</option><option>Weekly</option></select></label>
                                <label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Frequency</div><select value={routineFrequency} onChange={(event) => setRoutineFrequency(event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none"><option>Daily</option><option>2-3 times/week</option><option>Weekly</option><option>As needed</option></select></label>
                            </div>
                        </div>

                        <div className="mt-5 grid gap-5 xl:grid-cols-[1fr_0.95fr]">
                            <div className="rounded-[1.5rem] border border-slate-200 bg-stone-50 p-5">
                                <div className="flex items-center justify-between gap-3"><div className="text-sm font-bold text-slate-900">Visible Results</div><button type="button" onClick={() => setPdpBlocks((current) => ({ ...current, results: !current.results }))} className="rounded-full bg-white px-3 py-1.5 text-xs font-bold text-[#5E7F85]">{pdpBlocks.results ? "ON" : "OFF"}</button></div>
                                <div className="mt-4 grid gap-3"><input value={visibleResultTitle} onChange={(event) => setVisibleResultTitle(event.target.value)} className="rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" placeholder="Visible Results title" /><textarea value={visibleResultBullets} onChange={(event) => setVisibleResultBullets(event.target.value)} className="h-24 rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" placeholder="One result per line" /><select value={visibleResultMode} onChange={(event) => setVisibleResultMode(event.target.value)} className="rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none"><option>3 Cards</option><option>Image Slider</option><option>Static Before After</option></select></div>
                                <div className="mt-4 grid gap-3 md:grid-cols-3">
                                    {visibleResultCards.map((card) => <div key={card.id} className="rounded-2xl border border-slate-200 bg-white p-3">
                                        <button type="button" onClick={() => markVisibleResultImage(card.id)} className={`flex aspect-square w-full items-center justify-center rounded-xl border border-dashed text-xs font-bold ${card.imageReady ? "border-emerald-300 bg-emerald-50 text-emerald-700" : "border-slate-300 bg-stone-50 text-slate-400"}`}>{card.imageReady ? "Image Ready" : "Upload Image"}</button>
                                        <input value={card.title} onChange={(event) => updateVisibleResultCard(card.id, "title", event.target.value)} className="mt-3 w-full rounded-xl border border-slate-200 px-3 py-2 text-xs font-bold outline-none" placeholder="Card title" />
                                        <textarea value={card.text} onChange={(event) => updateVisibleResultCard(card.id, "text", event.target.value)} className="mt-2 h-16 w-full rounded-xl border border-slate-200 px-3 py-2 text-xs outline-none" placeholder="Result text" />
                                    </div>)}
                                </div>
                            </div>

                            <div className="rounded-[1.5rem] border border-slate-200 bg-stone-50 p-5">
                                <div className="flex items-center justify-between gap-3"><div className="text-sm font-bold text-slate-900">Frequently Bought Together</div><button type="button" onClick={() => setPdpBlocks((current) => ({ ...current, fbt: !current.fbt }))} className="rounded-full bg-white px-3 py-1.5 text-xs font-bold text-[#5E7F85]">{pdpBlocks.fbt ? "ON" : "OFF"}</button></div>
                                <div className="mt-4 space-y-3">{catalogProducts.slice(0, 4).map((item) => <label key={item.name} className="flex items-center justify-between gap-3 rounded-2xl bg-white px-4 py-3 text-sm"><span className="font-semibold text-slate-700">{item.name}</span><input type="checkbox" checked={fbtProducts.includes(item.name)} onChange={() => toggleListItem(item.name, setFbtProducts)} className="h-4 w-4 rounded border-slate-300" /></label>)}</div>
                                <div className="mt-4 grid gap-3 sm:grid-cols-2"><label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Bundle Discount</div><input value={fbtDiscount} onChange={(event) => setFbtDiscount(event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" /></label><div className="rounded-2xl bg-white p-4 text-sm"><div className="text-xs text-slate-500">Final Total</div><div className="mt-1 text-lg font-bold text-[#5E7F85]">৳{fbtFinalTotal.toLocaleString()}</div></div></div>
                            </div>
                        </div>

                        <div className="mt-5 rounded-[1.5rem] border border-slate-200 bg-stone-50 p-5">
                            <div className="flex items-center justify-between gap-3"><div className="text-sm font-bold text-slate-900">Product FAQ</div><button type="button" onClick={addFaq} className="rounded-xl bg-[#5E7F85]/10 px-3 py-2 text-xs font-bold text-[#5E7F85]">+ Add FAQ</button></div>
                            <div className="mt-4 space-y-3">
                                {productFaqs.map((faq, index) => <div key={faq.id} className="rounded-2xl border border-slate-200 bg-white p-4">
                                    <div className="mb-3 flex items-center justify-between gap-3"><span className="text-xs font-bold uppercase tracking-[0.12em] text-slate-400">FAQ {index + 1}</span><button type="button" onClick={() => removeFaq(faq.id)} className="rounded-lg border border-rose-200 bg-rose-50 px-2 py-1 text-xs font-bold text-rose-700">Remove</button></div>
                                    <input value={faq.question} onChange={(event) => updateFaq(faq.id, "question", event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-stone-50 px-4 py-3 text-sm font-semibold outline-none" placeholder="Question" />
                                    <textarea value={faq.answer} onChange={(event) => updateFaq(faq.id, "answer", event.target.value)} className="mt-3 h-20 w-full rounded-2xl border border-slate-300 bg-stone-50 px-4 py-3 text-sm outline-none" placeholder="Answer" />
                                </div>)}
                                {productFaqs.length === 0 && <div className="rounded-2xl border border-dashed border-slate-300 bg-white p-6 text-center text-xs font-semibold text-slate-500">No FAQ added yet.</div>}
                            </div>
                        </div>


                        <div className="mt-5 grid gap-5 xl:grid-cols-1">
                            <div className="rounded-[1.5rem] border border-slate-200 bg-stone-50 p-5">
                                <div className="text-sm font-bold text-slate-900">Claim & Safety Compliance</div>
                                <div className="mt-4 grid gap-3"><label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Skin Type</div><input value={skinType} onChange={(event) => setSkinType(event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" /></label><label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Claim Level</div><select value={claimLevel} onChange={(event) => setClaimLevel(event.target.value)} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none"><option>Cosmetic Claim Only</option><option>Needs Review</option><option>Do Not Publish</option></select></label><label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Suitable For</div><textarea value={suitableFor} onChange={(event) => setSuitableFor(event.target.value)} className="h-20 w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" /></label><label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Not Suitable For</div><textarea value={notSuitableFor} onChange={(event) => setNotSuitableFor(event.target.value)} className="h-20 w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" /></label><label className="space-y-2"><div className="text-xs font-semibold text-slate-500">Patch Test Note</div><textarea value={patchTestNote} onChange={(event) => setPatchTestNote(event.target.value)} className="h-20 w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" /></label></div>
                            </div>
                        </div>
                    </div>

                    <div className="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
                        <div className="flex items-center justify-between gap-3"><h2 className="text-xl font-bold tracking-tight">SEO Settings</h2><Badge tone="brand">Search Ready</Badge></div>
                        <div className="mt-5 grid gap-4 md:grid-cols-2"><label className="space-y-2"><div className="text-sm font-medium text-slate-600">SEO Title</div><input value={seoTitle} onChange={(event) => { setSeoTitle(event.target.value); setSaveStatus("Unsaved changes"); }} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" placeholder="Product SEO title" /></label><label className="space-y-2"><div className="text-sm font-medium text-slate-600">Focus Keyword</div><input value={focusKeyword} onChange={(event) => { setFocusKeyword(event.target.value); setSaveStatus("Unsaved changes"); }} className="w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none" placeholder="acne facewash bangladesh" /></label><label className="block space-y-2 md:col-span-2"><div className="text-sm font-medium text-slate-600">Meta Description</div><textarea value={metaDescription} onChange={(event) => { setMetaDescription(event.target.value); setSaveStatus("Unsaved changes"); }} className="h-24 w-full rounded-2xl border border-slate-300 px-4 py-3 text-sm outline-none" placeholder="Write product meta description" /></label></div>
                        <div className="mt-5 rounded-[1.5rem] border border-slate-200 bg-stone-50 p-5">
                            <div className="flex items-center justify-between gap-3"><div className="text-sm font-bold text-slate-900">SEO Checklist</div><Badge tone={seoChecks.every((item) => item.ok) ? "good" : "warn"}>{seoChecks.filter((item) => item.ok).length}/{seoChecks.length}</Badge></div>
                            <div className="mt-4 grid gap-2 md:grid-cols-2">{seoChecks.map((item) => <div key={item.label} className={`rounded-xl px-3 py-2 text-xs font-semibold ${item.ok ? "bg-emerald-50 text-emerald-700" : "bg-white text-slate-500"}`}>{item.ok ? "✅" : "○"} {item.label}</div>)}</div>
                        </div>
                    </div>
                </div>

                <div className="space-y-6">
                    <div className="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
                        <div className="flex items-center justify-between gap-3"><h2 className="text-xl font-bold tracking-tight">Live Frontend Preview</h2><Badge tone="brand">PDP</Badge></div>
                        <div className="mt-5 rounded-3xl border border-slate-200 p-4">
                            <div className="grid gap-4"><div className="grid grid-cols-[76px_1fr] gap-3"><div className="space-y-2">{galleryImages.slice(0, 3).map((item) => <div key={item} className="flex h-16 items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-stone-50 text-[10px] text-slate-400">{item}</div>)}</div><div className={`flex h-56 items-center justify-center rounded-3xl border border-dashed ${mainImageReady ? "border-emerald-300 bg-emerald-50 text-emerald-700" : "border-slate-300 bg-stone-50 text-slate-400"} text-xs font-bold`}>{mainImageReady ? "Validated Main Image" : "Main Product Image"}</div></div>
                                <div><div className="flex flex-wrap gap-2"><Badge tone="brand">{productLabel}</Badge><Badge tone="good">{productBadge}</Badge>{freeDelivery && <Badge tone="good">FREE DELIVERY</Badge>}<Badge tone={websiteVisible ? "good" : "bad"}>{websiteVisible ? "VISIBLE" : "HIDDEN"}</Badge><Badge tone={stockRule === "Sellable" ? "good" : stockRule === "Notify Me" ? "warn" : "bad"}>{stockRule.toUpperCase()}</Badge>{isVariantProduct && <Badge tone="brand">VARIANT PRODUCT</Badge>}<Badge tone="warn">SAVE ৳{Math.max(Number(previewRegularPrice || 0) - Number(previewSalePrice || 0), 0)}</Badge></div><div className="mt-3 text-lg font-bold leading-snug text-slate-900">{productName || "Product Name Preview"}</div><div className="mt-1 flex flex-wrap items-center gap-2 text-xs text-slate-500"><span>⭐ 4.8</span><span>•</span><span>128 reviews</span><span>•</span><span>{isVariantProduct ? `SKU ${selectedVariant.sku}` : `SKU ${autoSku}`}</span></div>{isVariantProduct && <div className="mt-3 flex flex-wrap gap-2">{variants.map((item) => <button key={item.id} onClick={() => setSelectedVariantId(item.id)} className={`rounded-xl border px-3 py-2 text-xs font-bold ${selectedVariant.id === item.id ? "border-[#5E7F85] bg-[#5E7F85] text-white" : "border-slate-200 bg-stone-50 text-slate-700"}`}>{item.option}</button>)}</div>}<div className="mt-3 flex items-end gap-2"><span className="text-2xl font-bold text-slate-900">৳{previewSalePrice}</span><span className="pb-1 text-sm text-slate-400 line-through">৳{previewRegularPrice}</span></div><div className="mt-3 flex flex-wrap gap-2 text-xs"><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">{brand}</span><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">{category}</span><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">{subcategory}</span><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">{concern}</span><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">{routineStep}</span><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">{routineTime}</span><span className="rounded-full bg-stone-100 px-3 py-1 text-slate-600">Stock {previewStockQty}</span></div><div className="mt-4 grid grid-cols-2 gap-2"><button className="rounded-2xl border border-slate-300 bg-white px-4 py-3 text-xs font-bold text-slate-700">{messengerOrder ? "Messenger" : "Messenger Off"}</button><button className={`rounded-2xl px-4 py-3 text-xs font-bold ${stockRule === "Sellable" && websiteVisible ? "bg-[#5E7F85] text-white" : "bg-slate-200 text-slate-500"}`}>{stockRule === "Sellable" && websiteVisible ? "Add to Cart" : stockRule === "Notify Me" ? "Notify Me" : "Unavailable"}</button></div></div></div>
                        </div>
                        <div className="mt-5 rounded-3xl border border-slate-200 bg-stone-50 p-4"><div className="text-sm font-bold text-slate-900">SEO Snippet Preview</div><div className="mt-3 rounded-2xl bg-white p-4"><div className="text-sm text-blue-700">{seoTitleText}</div><div className="mt-1 text-xs text-emerald-700">brandnbeauty.com/product/{autoSlug}</div><div className="mt-2 text-xs leading-5 text-slate-500">{metaDescriptionText}</div>{focusKeyword && <div className="mt-3 rounded-xl bg-stone-50 px-3 py-2 text-xs font-semibold text-[#5E7F85]">Focus keyword: {focusKeyword}</div>}</div></div>
                    </div>

                    <div className="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
                        <div className="flex items-center justify-between gap-3"><h2 className="text-xl font-bold">Publish Control</h2><Badge tone="good">Ready</Badge></div>
                        <div className="mt-5 space-y-3 text-sm">
                            <div className="rounded-2xl bg-stone-50 p-4"><div className="flex items-center justify-between gap-3"><span>Product Type</span><b className="text-[#5E7F85]">{productType}</b></div></div>
                            <div className="rounded-2xl bg-stone-50 p-4"><div className="flex items-center justify-between gap-3"><span>Status</span><select value={status} onChange={(event) => setStatus(event.target.value)} className="rounded-xl border border-slate-200 px-3 py-2 text-xs"><option>Draft</option><option>Published</option><option>Hidden</option><option>Discontinued</option></select></div><div className="mt-2 text-xs leading-5 text-slate-500">Draft/Hidden product website e show hobe na. Discontinued product archive hisebe thakbe.</div></div>
                            <div className="rounded-2xl bg-stone-50 p-4"><div className="flex items-center justify-between gap-3"><span>Stock Rule</span><select value={stockRule} onChange={(event) => setStockRule(event.target.value)} className="rounded-xl border border-slate-200 px-3 py-2 text-xs"><option>Sellable</option><option>Notify Me</option><option>Preorder</option><option>Disabled</option></select></div><div className="mt-2 text-xs leading-5 text-slate-500">Sellable = Add to Cart active. Notify Me = cart disabled but lead capture active.</div></div>
                            <div className="rounded-2xl bg-stone-50 p-4"><div className="flex items-center justify-between gap-3"><span>Out of Stock Behavior</span><select value={outOfStockBehavior} onChange={(event) => setOutOfStockBehavior(event.target.value)} className="rounded-xl border border-slate-200 px-3 py-2 text-xs"><option>Show with Notify Me</option><option>Show with Messenger</option><option>Hide from Website</option></select></div></div>
                            <div className="rounded-2xl bg-stone-50 p-4"><div className="mb-3 text-sm font-semibold text-slate-700">Storefront Trust Badges</div><div className="grid gap-2 sm:grid-cols-2">{["Authentic", "COD", "Fast Delivery", "Imported"].map((item) => <button key={item} type="button" onClick={() => toggleListItem(item, setTrustBadges)} className={`rounded-xl px-3 py-2 text-left text-xs font-bold ${trustBadges.includes(item) ? "bg-[#5E7F85] text-white" : "bg-white text-slate-600"}`}>{item}</button>)}</div></div>
                            {[["Website Visible", websiteVisible, setWebsiteVisible], ["Track Stock", trackStock, setTrackStock], ["Messenger Order", messengerOrder, setMessengerOrder], ["Featured", featured, setFeatured], ["Free Delivery", freeDelivery, setFreeDelivery]].map(([label, value, setter]) => <div key={label} className="flex items-center justify-between rounded-2xl bg-stone-50 p-4"><span>{label}</span><button onClick={() => setter(!value)} className="font-semibold text-[#5E7F85]">{value ? "ON" : "OFF"}</button></div>)}
                        </div>
                        <div className="mt-5 space-y-3"><button onClick={() => showActionToast("Product preview generated")} className="w-full rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold">Preview Product</button><button onClick={saveDraft} className="w-full rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold">Save Draft</button><button onClick={() => setPublishModalOpen(true)} className="w-full rounded-2xl bg-[#5E7F85] px-5 py-3 text-sm font-semibold text-white">Publish Product</button></div>
                    </div>


                    <div className="rounded-[2rem] border border-amber-200 bg-amber-50 p-6"><h2 className="text-xl font-bold text-amber-900">Smart Checks</h2><div className="mt-4 space-y-3 text-sm text-amber-900">{smartChecks.map((check) => <div key={check.label} className={`rounded-2xl p-4 ${check.tone === "good" ? "bg-emerald-50 text-emerald-700" : "bg-white/70 text-amber-900"}`}>{check.icon} {check.label}</div>)}</div></div>
                </div>
            </div>
        </div>

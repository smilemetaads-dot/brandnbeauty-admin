    if (page === "Customers") return <CustomersPage />;
    if (page === "Suppliers") return <SuppliersPage />;
    if (page === "Homepage CMS") return <HomepageCMSPage />;
    if (page === "Banner CMS") return <BannerCMSPage />;
    if (page === "Header & Navigation") return <HeaderNavigationPage />;
    if (page === "Footer CMS") return <FooterCMSPage />;

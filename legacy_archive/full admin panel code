}

function getStatsForPage(active) {
    const pagesWithMetrics = ["Dashboard", "Products", "Inventory", "Business Analytics"];
    if (!pagesWithMetrics.includes(active)) return [];
    if (active === "Products") return statSets.Products;
    if (active === "Inventory") return statSets.Inventory;
    if (active === "Business Analytics") return statSets.Reports;
    return statSets.Dashboard;
}


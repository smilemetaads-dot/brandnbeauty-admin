    if (page === "Products") return <ProductsPage onEditProduct={() => onNavigate && onNavigate("Add/Edit Product")} />;
    if (page === "Inventory") return <InventoryPage />;
    if (page === "Order Details") return <DetailPage selectedOrder={selectedOrder} />;
